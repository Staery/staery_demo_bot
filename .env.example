# Copy this file to .env and fill in the values. Never commit .env.

# Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token

# Comma-separated Telegram user IDs that may use /stats and /broadcast
ADMIN_IDS=

# Language used when the user's Telegram language is not supported: en | ru
DEFAULT_LANGUAGE=en

# SQLite database file (the directory is created automatically)
DATABASE_PATH=data/bot.sqlite3

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Anti-flood: at most RATE_LIMIT_MESSAGES updates per RATE_LIMIT_PERIOD seconds per user
RATE_LIMIT_MESSAGES=6
RATE_LIMIT_PERIOD=4

# Update delivery mode: polling | webhook
MODE=polling

# Webhook settings (used only when MODE=webhook)
# Public HTTPS base URL that Telegram can reach, e.g. https://bot.example.com
WEBHOOK_URL=
WEBHOOK_PATH=telegram
WEBHOOK_SECRET=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8080
